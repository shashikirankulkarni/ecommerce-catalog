# Template for the Postgres container credentials.
#     cp .env.example .env
#
# .env is gitignored; this file is committed and must stay empty of real
# values. It documents which variables docker-compose expects.
#
# CATALOG_LOCAL_PASSWORD must match DB_PASSWORD in the project-root .env,
# since that is the credential the application uses against catalog_local.

POSTGRES_PASSWORD=
CATALOG_LOCAL_PASSWORD=
CATALOG_DEV_PASSWORD=
CATALOG_QA_PASSWORD=
