[req]
distinguished_name = dn
x509_extensions    = v3_req
prompt             = no

[dn]
C  = IN
ST = Karnataka
L  = Bengaluru
O  = Catalog Local Development
CN = catalog.com

# Subject Alternative Names are what browsers actually check. The Common
# Name field above has been ignored by Chrome since version 58, so a cert
# without this section is rejected outright regardless of what CN says.
[v3_req]
basicConstraints = CA:TRUE
keyUsage         = digitalSignature, keyEncipherment, keyCertSign
extendedKeyUsage = serverAuth
subjectAltName   = @alt_names

[alt_names]
DNS.1 = catalog.com
DNS.2 = dev.catalog.com
DNS.3 = qa.catalog.com
DNS.4 = localhost
IP.1  = 127.0.0.1
