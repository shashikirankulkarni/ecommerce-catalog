# Template for local development. Copy to .env and fill in values.
#     cp .env.example .env
#
# .env is gitignored. This file is committed, so it must stay empty of
# real values - it exists to document which variables are required.
#
# On dev / qa / prod these variables are NOT read from a file in the
# repo. The deploy workflow renders /opt/catalog/.env on the server
# from GitHub Environment Secrets, on every deploy.

DB_PASSWORD=
JWT_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MERCHANT_ID=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Optional - these have defaults in application.properties
# SERVER_PORT=8080
# JWT_EXPIRY_MINUTES=60
# AWS_REGION=ap-south-1
